# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

.env

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma


# Prisma
/prisma/*.db
/prisma/*.db-journal
/prisma/migrations/*.sql
!/prisma/migrations/migration_lock.toml

# Prisma Client (генерируется автоматически)
node_modules/.prisma/
node_modules/@prisma/

# Логи сервера
*.log
logs/
.pnpm-store/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Системные файлы Windows
Thumbs.db
Desktop.ini

# Бэкапы и временные файлы
*.bak
*.tmp
*.temp